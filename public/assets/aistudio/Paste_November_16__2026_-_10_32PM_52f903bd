    function initSupabaseIfConfigured() {
      const { supabaseUrl, supabaseKey } = appState.config;
      if (supabaseUrl && supabaseKey && window.supabase) {
        try {
          supabaseClient = window.supabase.createClient(supabaseUrl, supabaseKey);
          // Verifica sessão ativa do usuário
          supabaseClient.auth.getSession().then(({ data }) => {
            if (data && data.session) {
              setLoggedUser(data.session.user);
            }
          });
          // Escuta mudanças de login/logout (inclusive retorno do Google OAuth)
          supabaseClient.auth.onAuthStateChange((_event, session) => {
            setLoggedUser(session ? session.user : null);
          });
        } catch (err) {
          console.error('Erro ao inicializar Supabase:', err);
        }
      }
    }

    function setLoggedUser(user) {
      appState.currentUser = user;
      const navText = document.getElementById('auth-nav-text');
      const loggedBox = document.getElementById('auth-logged-in-box');
      const loggedEmail = document.getElementById('logged-user-email');

      if (user) {
        navText.textContent = user.email ? user.email.split('@')[0] : 'Minha Conta';
        loggedBox.classList.remove('hidden');
        loggedEmail.textContent = `Logado como: ${user.email}`;
      } else {
        navText.textContent = 'Entrar';
        loggedBox.classList.add('hidden');
      }
