    /**
     * =========================================================================
     * 4. CHECKOUT PIX GOLD & SIMULAÇÃO DE WEBHOOK + BOT TELEGRAM
     * =========================================================================
     */
    function openCheckoutModal(kind, itemId = null) {
      let itemData = null;

      if (kind === 'subscription') {
        itemData = {
          kind: 'subscription',
          id: 'vip-monthly',
          title: 'Assinatura Mensal Ruivinha VIP (30 dias)',
          price: 49.90
        };
      } else if (kind === 'ppv') {
        const post = postsList.find(p => p.id === itemId);
        if (!post) return;
        itemData = {
          kind: 'ppv',
          id: post.id,
          title: `Conteúdo Avulso: ${post.caption.slice(0, 38)}...`,
          price: Number(post.price)
        };
      } else if (kind === 'package') {
        const pkg = CALLS_AND_PACKAGES.find(c => c.id === itemId);
        if (!pkg) return;
        itemData = {
          kind: pkg.type, // 'call' | 'pack'
          id: pkg.id,
          title: pkg.title,
          price: pkg.price
        };
      }

      appState.checkoutItem = itemData;

      // Reseta etapas do modal
      document.getElementById('checkout-step-form').classList.remove('hidden');
      document.getElementById('checkout-step-qrcode').classList.add('hidden');
      document.getElementById('checkout-step-success').classList.add('hidden');

      document.getElementById('checkout-item-title').textContent = itemData.title;
      document.getElementById('checkout-item-price').textContent = `R$ ${itemData.price.toFixed(2).replace('.', ',')}`;

      const modal = document.getElementById('checkout-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeCheckoutModal() {
      const modal = document.getElementById('checkout-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function generatePixGoldQrCode() {
      const tgInput = document.getElementById('checkout-telegram-user').value.trim().replace(/^@/, '');
      if (!tgInput) {
        showToast('Por favor, informe seu @ do Telegram para entrega ou chamada.', 'error');
        return;
      }

      appState.checkoutItem.telegramUser = `@${tgInput}`;

      /**
       * TODO: INTEGRAR API REAL DO PIX GOLD AQUI (VIA SERVERLESS FUNCTION NA VERCEL)
       * Exemplo de chamada ao seu backend /api/create-pix:
       * const res = await fetch('/api/create-pix', {
       *   method: 'POST',
       *   body: JSON.stringify({
       *     amount: appState.checkoutItem.price,
       *     itemId: appState.checkoutItem.id,
       *     telegramUser: appState.checkoutItem.telegramUser
       *   })
       * });
       * const { qrCodeCopyPaste, qrCodeBase64, txId } = await res.json();
       */

      document.getElementById('qr-item-summary').textContent =
        `${appState.checkoutItem.title} • R$ ${appState.checkoutItem.price.toFixed(2).replace('.', ',')}`;

      document.getElementById('checkout-step-form').classList.add('hidden');
      document.getElementById('checkout-step-qrcode').classList.remove('hidden');
      showToast('QR Code Pix Gold gerado! Aguardando pagamento...', 'info');
    }

    function copyPixCode() {
      const input = document.getElementById('pix-copy-paste-input');
      input.select();
      input.setSelectionRange(0, 99999);
      document.execCommand('copy');
      showToast('Código Pix Copia e Cola copiado!', 'success');
    }

    function simulatePixGoldWebhookPaid() {
      const item = appState.checkoutItem;
      if (!item) return;

      // 1. Libera o acesso no estado local (em produção isso ocorre via Supabase Realtime após o Webhook)
      if (item.kind === 'subscription') {
        appState.isVipSubscriber = true;
        localStorage.setItem(STORAGE_KEYS.SUBSCRIPTION, 'true');
      } else if (item.kind === 'ppv') {
        if (!appState.unlockedPostIds.includes(item.id)) {
          appState.unlockedPostIds.push(item.id);
          localStorage.setItem(STORAGE_KEYS.UNLOCKED, JSON.stringify(appState.unlockedPostIds));
        }
      }

      // 2. Monta as mensagens que o Bot do Telegram envia automaticamente
      const creatorMsg = item.kind === 'call'
        ? `🚨 NOVO PIX RECEBIDO (R$ ${item.price.toFixed(2)})!\nCliente ${item.telegramUser} comprou: "${item.title}".\nChame ele agora no Telegram para iniciar a videochamada!`
        : `💰 NOVO PIX RECEBIDO (R$ ${item.price.toFixed(2)})!\nCliente ${item.telegramUser} adquiriu: "${item.title}".\nSaldo convertido em cripto na sua carteira Pix Gold.`;

      const clientMsg = item.kind === 'call'
        ? `✅ Pagamento confirmado! A Ruivinha VIP já foi notificada sobre sua "${item.title}" e vai te chamar aqui em instantes.`
        : `🔥 Obrigada pelo apoio! Seu acesso para "${item.title}" já foi liberado no site Ruivinha VIP e seu link privado está ativo.`;

      document.getElementById('tg-creator-preview-msg').innerText = creatorMsg;
      document.getElementById('tg-client-preview-msg').innerText = clientMsg;

      // 3. Registra no histórico do Painel Admin
      appState.transactions.unshift({
        time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }),
        client: item.telegramUser,
        title: item.title,
        amount: item.price
      });
      localStorage.setItem(STORAGE_KEYS.LOGS, JSON.stringify(appState.transactions));

      // 4. Atualiza interface
      updateVipStatusUI();
      renderFeed();
      renderAdminLogs();

      document.getElementById('checkout-step-qrcode').classList.add('hidden');
      document.getElementById('checkout-step-success').classList.remove('hidden');
      showToast('Pagamento aprovado e conteúdo liberado!', 'success');
    }

    /**
     * =========================================================================
     * 5. AUTENTICAÇÃO (GOOGLE OAUTH + E-MAIL E SENHA)
     * =========================================================================
     */
    function openAuthModal() {
      const modal = document.getElementById('auth-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeAuthModal() {
      const modal = document.getElementById('auth-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function setAuthMode(mode) {
      appState.authMode = mode;
      const loginTab = document.getElementById('auth-tab-login');
      const signupTab = document.getElementById('auth-tab-signup');
      const submitBtn = document.getElementById('auth-submit-btn');

      if (mode === 'login') {
        loginTab.className = 'py-1.5 rounded-lg text-xs font-semibold bg-zinc-800 text-white transition-all';
        signupTab.className = 'py-1.5 rounded-lg text-xs font-semibold text-zinc-400 hover:text-white transition-all';
        submitBtn.textContent = 'Entrar na Conta';
      } else {
        signupTab.className = 'py-1.5 rounded-lg text-xs font-semibold bg-zinc-800 text-white transition-all';
        loginTab.className = 'py-1.5 rounded-lg text-xs font-semibold text-zinc-400 hover:text-white transition-all';
        submitBtn.textContent = 'Criar Conta Grátis';
      }
    }

    async function loginWithGoogle() {
      if (!supabaseClient) {
        showToast('Configure a URL e Anon Key do Supabase no Painel Admin para ativar o Google Login real.', 'info');
        return;
      }
      const { error } = await supabaseClient.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin }
      });
      if (error) showToast(`Erro Google Auth: ${error.message}`, 'error');
    }

    async function handleEmailAuth(e) {
      e.preventDefault();
      const email = document.getElementById('auth-email').value.trim();
      const password = document.getElementById('auth-password').value;

      if (!supabaseClient) {
        // Modo demonstração caso o Supabase ainda não tenha sido conectado
        setLoggedUser({ email });
        closeAuthModal();
        showToast(`Modo Demo: Bem-vindo, ${email}!`, 'success');
        return;
      }

      if (appState.authMode === 'login') {
        const { error } = await supabaseClient.auth.signInWithPassword({ email, password });
        if (error) return showToast(error.message, 'error');
        showToast('Login realizado com sucesso!', 'success');
        closeAuthModal();
      } else {
        const { error } = await supabaseClient.auth.signUp({ email, password });
        if (error) return showToast(error.message, 'error');
        showToast('Conta criada! Verifique seu e-mail ou faça login.', 'success');
        setAuthMode('login');
      }
    }

    async function logoutUser() {
      if (supabaseClient) await supabaseClient.auth.signOut();
      setLoggedUser(null);
      closeAuthModal();
      showToast('Você saiu da sua conta.', 'info');
    }

    /**
     * =========================================================================
     * 6. FUNÇÕES DO PAINEL ADMIN (CRIADORA) & UTILITÁRIOS DE UI
     * =========================================================================
     */
    function switchTab(tabName) {
      ['feed', 'calls', 'admin'].forEach(name => {
        document.getElementById(`view-${name}`).classList.add('hidden');
        const btn = document.getElementById(`tab-btn-${name}`);
        btn.classList.remove('border-copper-500', 'text-white');
        btn.classList.add('border-transparent', 'text-zinc-400');
      });

      document.getElementById(`view-${tabName}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-btn-${tabName}`);
      activeBtn.classList.remove('border-transparent', 'text-zinc-400');
      activeBtn.classList.add('border-copper-500', 'text-white');
    }

    function filterFeed(filter) {
      appState.activeFilter = filter;
      document.querySelectorAll('.feed-filter-btn').forEach(btn => {
        if (btn.dataset.filter === filter) {
          btn.className = 'feed-filter-btn active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-copper-600 text-white transition-all';
        } else {
          btn.className = 'feed-filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-obsidian-900 border border-zinc-800 text-zinc-400 hover:text-white transition-all';
        }
      });
      renderFeed();
    }

    function toggleDemoVipMode() {
      appState.isVipSubscriber = !appState.isVipSubscriber;
      localStorage.setItem(STORAGE_KEYS.SUBSCRIPTION, String(appState.isVipSubscriber));
      updateVipStatusUI();
      renderFeed();
      showToast(
        appState.isVipSubscriber
          ? 'Modo Preview VIP ATIVADO: Conteúdos de assinatura desbloqueados!'
          : 'Modo Visitante ATIVADO: Conteúdos bloqueados novamente.',
        'info'
      );
    }

    function updateVipStatusUI() {
      const badge = document.getElementById('vip-status-badge');
      const dot = document.getElementById('demo-vip-dot');
      const label = document.getElementById('demo-vip-label');
      const heroBtn = document.getElementById('hero-subscribe-btn');

      if (appState.isVipSubscriber) {
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span><span class="text-emerald-400">Assinante VIP</span>`;
        dot.className = 'w-2 h-2 rounded-full bg-emerald-400';
        label.textContent = 'Simular Visão VIP: ON';
        heroBtn.innerHTML = `<span>✓ Assinatura VIP Ativa</span>`;
      } else {
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-zinc-500"></span><span>Visitante</span>`;
        dot.className = 'w-2 h-2 rounded-full bg-zinc-500';
        label.textContent = 'Simular Visão VIP: OFF';
        heroBtn.innerHTML = `<span>Assinar VIP • R$ 49,90/mês</span>`;
      }
    }

    function toggleAdminMediaFields() {
      const mediaType = document.getElementById('post-media-type').value;
      const bunnyField = document.getElementById('admin-bunny-field');
      bunnyField.classList.toggle('hidden', mediaType !== 'video');
    }

    function toggleAdminPriceField() {
      const accessType = document.getElementById('post-access-type').value;
      const priceField = document.getElementById('admin-price-field');
      priceField.classList.toggle('hidden', accessType !== 'ppv');
    }

    function handleCreatePost(e) {
      e.preventDefault();
      const caption = document.getElementById('post-caption').value.trim();
      const mediaType = document.getElementById('post-media-type').value;
      const accessType = document.getElementById('post-access-type').value;
      const bunnyVideoId = document.getElementById('post-bunny-id').value.trim();
      const thumbUrl = document.getElementById('post-thumb-url').value.trim();
      const price = parseFloat(document.getElementById('post-price').value || '0');

      const newPost = {
        id: `post-${Date.now()}`,
        createdAt: 'Agora mesmo',
        caption,
        mediaType,
        accessType,
        price: accessType === 'ppv' ? price : 0,
        thumbUrl: thumbUrl || 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80',
        bunnyVideoId,
        likes: 1
      };

      postsList.unshift(newPost);
      localStorage.setItem(STORAGE_KEYS.POSTS, JSON.stringify(postsList));
      document.getElementById('new-post-form').reset();
      renderFeed();
      switchTab('feed');
      showToast('Novo conteúdo publicado no Feed!', 'success');
    }

    function saveApiConfig(e) {
      e.preventDefault();
      appState.config = {
        supabaseUrl: document.getElementById('cfg-supabase-url').value.trim(),
        supabaseKey: document.getElementById('cfg-supabase-key').value.trim(),
        bunnyLibId: document.getElementById('cfg-bunny-lib').value.trim(),
        pixGoldKey: document.getElementById('cfg-pixgold-key').value.trim(),
        tgBotToken: document.getElementById('cfg-tg-token').value.trim(),
        tgChatId: document.getElementById('cfg-tg-chatid').value.trim()
      };
      localStorage.setItem(STORAGE_KEYS.CONFIG, JSON.stringify(appState.config));
      initSupabaseIfConfigured();
      renderFeed();
      showToast('Configurações salvas! Integrações atualizadas.', 'success');
    }

    function loadSavedConfigIntoInputs() {
      const c = appState.config;
      if (c.supabaseUrl) document.getElementById('cfg-supabase-url').value = c.supabaseUrl;
      if (c.supabaseKey) document.getElementById('cfg-supabase-key').value = c.supabaseKey;
      if (c.bunnyLibId) document.getElementById('cfg-bunny-lib').value = c.bunnyLibId;
      if (c.pixGoldKey) document.getElementById('cfg-pixgold-key').value = c.pixGoldKey;
      if (c.tgBotToken) document.getElementById('cfg-tg-token').value = c.tgBotToken;
      if (c.tgChatId) document.getElementById('cfg-tg-chatid').value = c.tgChatId;
    }

    function renderAdminLogs() {
      const container = document.getElementById('admin-transactions-log');
      if (appState.transactions.length === 0) return;

      container.innerHTML = appState.transactions.map(tx => `
        <div class="p-3 rounded-xl bg-obsidian-950 border border-zinc-800/80 flex items-center justify-between gap-2">
          <div>
            <span class="text-white font-semibold">${tx.client}</span>
            <span class="text-zinc-400"> • ${tx.title}</span>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-emerald-400 font-bold">R$ ${tx.amount.toFixed(2).replace('.', ',')}</span>
            <span class="text-[10px] text-zinc-500">${tx.time}</span>
          </div>
        </div>
      `).join('');
    }

    function likePost(postId) {
      const post = postsList.find(p => p.id === postId);
      if (post) {
        post.likes += 1;
        localStorage.setItem(STORAGE_KEYS.POSTS, JSON.stringify(postsList));
        renderFeed();
      }
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-emerald-950/95 border-emerald-500/50 text-emerald-200',
        error: 'bg-rose-950/95 border-rose-500/50 text-rose-200',
        info: 'bg-obsidian-900/95 border-copper-500/50 text-zinc-100'
      };
      toast.className = `pointer-events-auto px-4 py-3 rounded-2xl border ${colors[type] || colors.info} text-xs font-medium shadow-2xl backdrop-blur-md transition-all`;
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Inicialização ao carregar a página
    window.addEventListener('DOMContentLoaded', () => {
      loadSavedConfigIntoInputs();
      initSupabaseIfConfigured();
      updateVipStatusUI();
      renderFeed();
      renderCallsAndPackages();
      renderAdminLogs();
    });
  </script>
</body>
</html>