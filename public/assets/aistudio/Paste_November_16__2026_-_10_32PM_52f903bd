          <button onclick="openCheckoutModal('package', '${item.id}')" class="w-full py-3 rounded-xl ${item.highlight ? 'ruiva-gradient text-white shadow-md shadow-copper-600/20' : 'bg-zinc-800 hover:bg-zinc-700 text-white'} font-bold text-sm transition-all">
