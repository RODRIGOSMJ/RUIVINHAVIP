              `;
            } else {
              // Player demonstrativo visual quando ainda não inseriu o Library ID real do Bunny
              mediaContentHtml = `
                <div class="relative aspect-video w-full bg-obsidian-950 overflow-hidden group">
                  <img src="${post.thumbUrl}" onerror="this.src='https://placehold.co/900x500/18181d/ea580c?text=Video+VIP+Liberado'" alt="Vídeo Liberado" class="w-full h-full object-cover opacity-85" />
