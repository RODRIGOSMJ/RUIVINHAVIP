    function renderCallsAndPackages() {
      const container = document.getElementById('calls-packages-container');
      container.innerHTML = CALLS_AND_PACKAGES.map(item => `
        <div class="bg-obsidian-900 border ${item.highlight ? 'border-copper-500/60 shadow-lg shadow-copper-600/10' : 'border-zinc-800'} rounded-3xl p-5 sm:p-6 flex flex-col justify-between gap-5">
